# Frontend environment. Copy to .env.local — only NEXT_PUBLIC_-prefixed vars reach the browser.
# Everything with that prefix is public by design; never put secrets in this file.

# ---------------------------------------------------------------------------
# Server-side only — read by next.config.ts AT BUILD TIME, never inlined into the browser bundle.
# The rewrite target is frozen into the build: changing it needs a rebuild, not a restart.
# ---------------------------------------------------------------------------
# Where the Express API lives. Next rewrites /api and /x402 to it, so the browser only ever
# talks to the Next origin and the httpOnly session cookie stays same-site.
# Leave blank in development — defaults to http://127.0.0.1:4402.
BACKEND_ORIGIN=

# ---------------------------------------------------------------------------
# Public — inlined into the browser bundle at build time
# ---------------------------------------------------------------------------
# Google Identity Services client ID. Must be the same value as GOOGLE_CLIENT_ID
# in backend/.env, or token verification will reject the sign-in.
# Leave blank to hide the Google button and use magic link / email code only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public gateway origin shown in the onboarding preview. Defaults to the current
# origin, which is correct whenever the app and gateway are served together.
NEXT_PUBLIC_GATEWAY_URL=

# testnet | mainnet — selects which network the Pera wallet connects to for top-ups.
# Should match ALGORAND_NETWORK_PROFILE in backend/.env.
NEXT_PUBLIC_ALGORAND_NETWORK_PROFILE=testnet

# WalletConnect project ID, from dashboard.reown.com. Public by design: it identifies this
# app to the WalletConnect relay and ships in the client, so it is not a secret.
# Leave blank to hide every WalletConnect option. The relay refuses a session without it,
# so the wallet is not offered rather than offered and broken.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical app URL, sent to wallets as this app's identity when they show a connect prompt.
# Defaults to the current origin, which is right whenever the app is served from one place.
NEXT_PUBLIC_APP_URL=
